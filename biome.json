{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/coverage", "!design", "!research", "!spec/vectors"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "markdown": { "formatter": { "enabled": false }, "linter": { "enabled": false } },
  "yaml": { "formatter": { "enabled": false }, "linter": { "enabled": false } },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },
  "overrides": [
    { "includes": ["spec/adversarial/*.json"], "formatter": { "enabled": false } },
    { "includes": ["deploy/discovery/**/*.json"], "formatter": { "enabled": false } }
  ]
}
