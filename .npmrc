# Supply chain (CONTRIBUTING.md, "Supply chain"); the mechanism is a sibling repository's supply-chain rule (origin/main e098552).
# Exact versions only: `npm install <pkg>` writes "1.2.3", never "^1.2.3", so a range can never widen on its own.
save-exact=true
# engines.node (>=24) is enforced: npm refuses to install on an older Node instead of printing a warning.
engine-strict=true
# Dependencies never run install scripts: none is needed (every check passes without them), and a postinstall is
# how the 2025 npm worms spread. npm run and npm test still run this repository's own scripts.
ignore-scripts=true
# npm 11.10 and later resolve only versions published at least 7 days ago (an older npm ignores the line);
# scripts/check-release-age.mjs enforces the same rule on the lock, whatever npm version wrote it.
min-release-age=7
