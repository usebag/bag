{
  // `npm run typecheck` is `tsc -b`: every package, in dependency order. The references mirror the dependency graph
  // (cli -> edge -> core; mcp -> edge -> core; e2e uses all of them; the relay is Rust, in crates/ac-relay) and set
  // the build order. They do not stop a forbidden import: tsc treats a file reached through node_modules (the
  // workspace links) as a library and lets it in, so scripts/check-imports.sh is the gate for the direction.
  "files": [],
  "references": [
    { "path": "packages/core" },
    { "path": "packages/edge" },
    { "path": "packages/enterprise-client" },
    { "path": "packages/cli" },
    { "path": "packages/mcp" },
    { "path": "packages/shim" },
    { "path": "packages/a2a" },
    { "path": "packages/bag" },
    { "path": "packages/e2e" }
  ]
}
