{
  "name": "bag",
  "version": "0.0.0",
  "private": true,
  "description": "bag v0, the agent-to-agent spanning layer: spec, core, relay, edge and CLI. Pre-release.",
  "license": "Apache-2.0",
  "author": "Dilip Ramirez",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "biome ci .",
    "format:check": "biome format .",
    "typecheck": "tsc -b",
    "test": "npm test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w packages/e2e",
    "vectors:check": "npm run vectors:check -w packages/core",
    "adversarial:check": "npm run adversarial:check -w packages/core",
    "audit:bundled": "node scripts/check-bundled-advisories.mjs",
    "check": "scripts/last_step.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.12",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
