{
  "note": "Pairing word-code vectors. The code carries no integrity on its own; the six-digit SAS does. These vectors pin the codec and the S (invitation MAC key) derivation so the edge, the CLI and the Python verifier agree. The wordlist that generation draws from is a separate concern (licence pending); these vectors use fixed example words and do not require any word to be in the list. The members codec and s_derivation are maintained by hand; check_digits, request_mac, invite_string and pair_open (added 2026-11-03) are written from the shipped edge code by packages/edge/scripts/gen-pair-code-vectors.ts, whose --check fails when the code no longer reproduces them.",
  "codec": {
    "format": "canonical code = nameplate + '-' + words joined by '-'; nameplate is the leading all-digit token; words are lowercase a-z.",
    "parse": "split the input on runs of '-' and/or ASCII whitespace; trim; lowercase (NFKC); the first token (all digits) is the nameplate, the rest are the words. A leading/trailing separator is ignored. The parse is lenient on separators and case; generation always emits the canonical hyphen form.",
    "cases": [
      { "code": "472-tulip-orbit-cedar", "nameplate": "472", "words": ["tulip", "orbit", "cedar"] },
      { "input": "  472 Tulip  Orbit\tCedar ", "nameplate": "472", "words": ["tulip", "orbit", "cedar"] },
      { "input": "8-apple-river-stone", "nameplate": "8", "words": ["apple", "river", "stone"] }
    ]
  },
  "s_derivation": {
    "alg": "HKDF-SHA256",
    "ikm": "utf8( NFKC( lowercase( words joined by one ASCII space ) ) )",
    "salt": "utf8( nameplate + '|' + invitation )   (invitation is the one-time invitation identity I's address, the 'ed25519:'+64hex string, named `invitation` on the wire to match the built edge/relay shape; both sides hold it: the inviter created I, the acceptor reads it from the relay claim; a '|' separator is REQUIRED, not bare concatenation)",
    "info": "utf8( 'ac/peer-code/1' )",
    "L": 16,
    "output": "S, the 16-byte invitation MAC key; the pairing request is MAC'd under S exactly as the existing peer ceremony",
    "cases": [
      {
        "nameplate": "472",
        "words": ["tulip", "orbit", "cedar"],
        "invitation": "ed25519:3b6a27bcceb6a42d62a3a8d02a6f0d73653215771de243a63ac048a18b59da29",
        "s_hex": "129959107e3ecee229dd3a2e39f390d6"
      },
      {
        "nameplate": "8",
        "words": ["apple", "river", "stone"],
        "invitation": "ed25519:3b6a27bcceb6a42d62a3a8d02a6f0d73653215771de243a63ac048a18b59da29",
        "s_hex": "5cc6e99357dcba4f7337cd27217ab0c0"
      },
      {
        "nameplate": "1057",
        "words": ["maple", "signal", "harbor"],
        "invitation": "ed25519:3b6a27bcceb6a42d62a3a8d02a6f0d73653215771de243a63ac048a18b59da29",
        "s_hex": "d62599658cc66e4e85d06aef0e466b79"
      }
    ]
  },
  "check_digits": {
    "alg": "digits = decimal( uint32_be( sha256( utf8( canonical(['ac/peer-code/1', inviter, invitation, requester, sealing, S]) ) )[0..4] ) mod 10^6 ), left-padded with 0 to six digits; shown as three digits, one space, three digits",
    "fields": "inviter, invitation and requester are addresses; sealing is the requester X25519 public key in lowercase hex (its key record sealing_key, else its address record sealing_key); S is the 16-byte invitation MAC key as 32 lowercase hex characters",
